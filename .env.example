# 이 파일은 예시입니다. 실제로 사용할 때는 이 파일을 복사해 ".env" 라는 이름으로 저장하고
# 값을 채운 뒤, .env 파일은 절대 GitHub 등에 올리지 마세요. (.gitignore 에 이미 포함되어 있습니다)
#
# 지금 단계(app.py)는 EMAIL_TEST_MODE 만 사용하며, 실제 메일 발송 기능은 아직 구현되어
# 있지 않습니다. 아래 SMTP_* 값들은 나중에 실제 발송 기능을 추가할 때 사용할 자리표시자입니다.

# true 로 두면 실제 메일을 보내지 않고 화면/로그에만 발송 내역을 표시합니다.
EMAIL_TEST_MODE=true

# 관리자 페이지(pages/1_관리자_페이지.py) 접속 비밀번호. 반드시 example 값이 아닌
# 실제로 사용할 값으로 바꿔서 .env 파일에만 넣어두세요. (코드에는 절대 직접 쓰지 않습니다)
ADMIN_PASSWORD=change-me-before-use

# 향후 실제 메일 발송 연동 시 사용할 SMTP 설정 예시 (비밀번호 등은 절대 코드에 직접 쓰지 마세요)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=visitor-system@example.com
